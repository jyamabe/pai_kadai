<?xml version="1.0"?>
<robot name="color_sorting_robot">

  <!-- =========================
       Materials
       ========================= -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4 0.05 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="1.0 0.8 0.1 1.0"/>
  </material>

  <!-- =========================
       Main body
       ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.45 0.25"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.45 0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.12"
        ixy="0.0"
        ixz="0.0"
        iyy="0.20"
        iyz="0.0"
        izz="0.25"/>
    </inertial>
  </link>

  <!-- =========================
       Left wheel
       ========================= -->

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.27 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- =========================
       Right wheel
       ========================= -->

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.27 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- =========================
       Caster wheel
       ========================= -->

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001"
        iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.23 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       Camera
       ========================= -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.08 0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.08 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.58" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       LiDAR placeholder
       ========================= -->

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.43" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       Arm base
       ========================= -->

  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.12"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.002"
        iyz="0.0"
        izz="0.002"/>
    </inertial>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.22 0 0.38" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       First arm link
       ========================= -->

  <link name="arm_link_1">
    <visual>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.08 0.08"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.08 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.008"
        iyz="0.0"
        izz="0.008"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- =========================
       Second arm link
       ========================= -->

  <link name="arm_link_2">
    <visual>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.07 0.07"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.07 0.07"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia
        ixx="0.0007"
        ixy="0.0"
        ixz="0.0"
        iyy="0.004"
        iyz="0.0"
        izz="0.004"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0.36 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- =========================
       Gripper palm
       ========================= -->

  <link name="gripper_link">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.16 0.06"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.16 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.0003"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0003"
        iyz="0.0"
        izz="0.0003"/>
    </inertial>
  </link>

  <joint name="wrist_joint" type="fixed">
    <parent link="arm_link_2"/>
    <child link="gripper_link"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       Left gripper finger
       ========================= -->

  <link name="left_finger">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0002"
        iyz="0.0"
        izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="left_finger"/>
    <origin xyz="0.04 0.10 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.06" effort="5.0" velocity="0.2"/>
  </joint>

  <!-- =========================
       Right gripper finger
       ========================= -->

  <link name="right_finger">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.10"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0002"
        iyz="0.0"
        izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="right_finger"/>
    <origin xyz="0.04 -0.10 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.06" effort="5.0" velocity="0.2"/>
  </joint>

  <!-- =========================
       Gazebo differential drive
       ========================= -->

  <!-- 左車輪の摩擦 -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- 右車輪の摩擦 -->
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive_controller"
            filename="libgazebo_ros_diff_drive.so">

      <!-- 左右の車輪ジョイント -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- 車輪間距離と車輪直径 -->
      <wheel_separation>0.54</wheel_separation>
      <wheel_diameter>0.30</wheel_diameter>

      <!-- 速度制限 -->
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <!-- ROS 2トピック -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <!-- TFの公開 -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <!-- 更新周期 -->
      <update_rate>50</update_rate>

    </plugin>
  </gazebo>

  <!-- Gazebo用の色設定 -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_wheel">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="arm_base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="arm_link_1">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="arm_link_2">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="gripper_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="left_finger">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="right_finger">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <!-- =========================
       Gazebo camera sensor
       ========================= -->

  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>

      <camera name="sorting_camera">
        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>

      <plugin
        name="sorting_camera_controller"
        filename="libgazebo_ros_camera.so">

        <camera_name>sorting_camera</camera_name>
        <frame_name>camera_link</frame_name>
        <image_topic_name>image_raw</image_topic_name>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- =========================
       ros2_control
       ========================= -->

  <ros2_control name="ColorSortingSystem"
                type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so"
            name="gazebo_ros2_control">
      <parameters>
        /home/ubuntu/pai_kadai/src/my_robot_description/config/controllers.yaml
      </parameters>
    </plugin>
  </gazebo>

</robot>
